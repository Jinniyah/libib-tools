# Copy this file to .env and fill in the values you need. .env is gitignored —
# never commit real credentials or API keys.
#
# The web GUI (`python -m webapp`) loads .env automatically. Running a scraper
# directly from the CLI does not — export these as real environment variables
# for that use case instead.

# Kindle only — Chirp/Kobo/Nook login is manual in the browser, no credentials needed.
KINDLE_EMAIL=
KINDLE_PASSWORD=

# Optional AI metadata fallback (used only when Open Library and Google Books
# both leave a field blank; never used for series/group info). Leave unset to
# skip this stage entirely.
AI_PROVIDER=
OPENAI_API_KEY=

# Optional Google Books API key — a much larger quota than the anonymous
# default, so Google Books enrichment stops getting rate-limited. Get one
# free from Google Cloud Console (enable "Books API", create an API key,
# Application restrictions: None). Leave unset to keep using the anonymous
# endpoint.
GOOGLE_BOOKS_API_KEY=
